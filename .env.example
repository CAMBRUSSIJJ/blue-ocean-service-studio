# Browser configuration. Use the dedicated Blue Ocean project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never place a service_role or secret API key in a VITE_ variable.
# Plausible Analytics — domínio registrado em plausible.io (ex: studio.blueocean.app).
# Deixe em branco em desenvolvimento; o wrapper loga no console nesse caso.
VITE_PLAUSIBLE_DOMAIN=
